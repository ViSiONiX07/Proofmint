# Proofmint Environment Configuration Example
# Copy this file to .env and configure the values for your environment.

# API / Backend Configuration
API_PORT=8000
API_HOST=0.0.0.0
PROJECT_NAME="Proofmint Verification API"

# PostgreSQL Configuration (optional for API startup; required for persistence/migrations)
# Configure either DATABASE_URL or all POSTGRES_* values below. Never commit real credentials.
DATABASE_URL=
POSTGRES_SERVER=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Example local values (uncomment and replace the password in your ignored services/api/.env):
# POSTGRES_SERVER=localhost
# POSTGRES_USER=proofmint
# POSTGRES_PASSWORD=replace_with_local_password
# POSTGRES_DB=proofmint

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
